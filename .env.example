# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example

# Leave unset for SQLite (db.sqlite3). For Postgres:
# DATABASE_URL=postgres://chama:password@localhost:5432/chama_tracker

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Payments: paystack (default, fastest to go live) or daraja (your own paybill/till)
PAYMENT_PROVIDER=paystack
# Pending payments older than this are checked with the provider when their status is read.
PAYMENT_STATUS_CHECK_AFTER_SECONDS=20

# Paystack: Dashboard -> Settings -> API Keys & Webhooks. Use sk_test_... while testing.
# Webhook URL to set in the dashboard: https://<your-host>/api/pay/paystack/
# Members have no email; Paystack gets <phone>@members.<short_code>.<domain>.
# Use a domain you control in production if you want Paystack's receipts.
PAYSTACK_MEMBER_EMAIL_DOMAIN=example.com
PAYSTACK_SECRET_KEY=

# M-Pesa Daraja (only used when PAYMENT_PROVIDER=daraja): https://developer.safaricom.co.ke
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Public HTTPS base Daraja can reach (ngrok etc.). https://example.com works locally:
# callbacks never arrive, and the status endpoint falls back to stk_query.
MPESA_CALLBACK_BASE=https://example.com
# Secret path segment for the callback URL: /api/pay/hook/<token>/
MPESA_CALLBACK_TOKEN=change-me-to-a-long-random-string
